 "subs": [
  {
   "text": "„1200 ლარი რა",
   "start": 0.12,
   "end": 1.605,
   "tone": "white"
  },
  {
   "text": "დ#@%ს მივეცი?!“",
   "start": 1.605,
   "end": 2.81,
   "tone": "white",
   "censor": true
  },
  {
   "text": "„მე რა ვიცი, ძმაო,",
   "start": 3.05,
   "end": 4.78,
   "tone": "white"
  },
  {
   "text": "მანქანაა!“",
   "start": 4.97,
   "end": 6.08,
   "tone": "white"
  },
  {
   "text": "„ეს რაღა აინთო ახლა?“",
   "start": 9.62,
   "end": 11.29,
   "tone": "white"
  },
  {
   "text": "„აბა...",
   "start": 11.71,
   "end": 12.59,
   "tone": "white"
  },
  {
   "text": "სანთლებიც შესაცვლელია,",
   "start": 13.01,
   "end": 14.87,
   "tone": "white"
  },
  {
   "text": "კოჭაც, ესეც...“",
   "start": 15.08,
   "end": 17.03,
   "tone": "white"
  },
  {
   "text": "„ისევ?!“",
   "start": 21.49,
   "end": 21.99,
   "tone": "white"
  },
  {
   "text": "„ესეც კარგია, კარგიააა.",
   "start": 22.86,
   "end": 25.25,
   "tone": "white",
   "phone": true
  },
  {
   "text": "აბა ახლა სხვა ნაწილი ვნახოთ,",
   "start": 25.67,
   "end": 28.54,
   "tone": "ink",
   "phone": true
  },
  {
   "text": "მოიყვანე.“",
   "start": 29.04,
   "end": 29.59,
   "tone": "ink",
   "phone": true
  },
  {
   "text": "ჩეკი მხოლოდ იმას გეუბნება,",
   "start": 30.24,
   "end": 32.654,
   "tone": "white"
  },
  {
   "text": "რომ რაღაც ცუდადაა.",
   "start": 32.654,
   "end": 33.81,
   "tone": "white"
  },
  {
   "text": "რა, ამას არ გეუბნება.",
   "start": 34.45,
   "end": 36.36,
   "tone": "white"
  },
  {
   "text": "და გამოცნობაში ფულს შენ იხდი.",
   "start": 37.02,
   "end": 38.59,
   "tone": "white"
  },
  {
   "text": "მანქანა ყოველთვის გეუბნება,",
   "start": 46.64,
   "end": 48.432,
   "tone": "ink"
  },
  {
   "text": "რა სჭირს.",
   "start": 48.432,
   "end": 48.73,
   "tone": "ink"
  },
  {
   "text": "უბრალოდ,",
   "start": 49.34,
   "end": 49.847,
   "tone": "ink"
  },
  {
   "text": "აქამდე არავინ გითარგმნიდა.",
   "start": 49.847,
   "end": 51.06,
   "tone": "ink"
  },
  {
   "text": "მანქანის კომპიუტერი",
   "start": 51.71,
   "end": 52.889,
   "tone": "ink"
  },
  {
   "text": "ხარვეზებს კოდებად იმახსოვრებს.",
   "start": 52.889,
   "end": 54.44,
   "tone": "ink"
  },
  {
   "text": "საჭის ქვეშ პატარა ბუდეა, OBD.",
   "start": 55.03,
   "end": 57.11,
   "tone": "white"
  },
  {
   "text": "თითქმის ყველა თანამედროვე მანქანას აქვს.",
   "start": 57.64,
   "end": 59.75,
   "tone": "ink"
  },
  {
   "text": "ნებისმიერ იაფ ELM327",
   "start": 60.53,
   "end": 62.63,
   "tone": "ink"
  },
  {
   "text": "ადაპტერს ჩადებ,",
   "start": 62.63,
   "end": 63.9,
   "tone": "white"
  },
  {
   "text": "აპში სკანირებას დააჭერ",
   "start": 64.34,
   "end": 65.673,
   "tone": "ink"
  },
  {
   "text": "და ვინარი თვითონ იპოვის.",
   "start": 65.673,
   "end": 67.02,
   "tone": "ink"
  },
  {
   "text": "P0300 შენთვის არაფერს ნიშნავს.",
   "start": 68.92,
   "end": 71.47,
   "tone": "ink"
  },
  {
   "text": "ვინარი ქართულად გეტყვის:",
   "start": 72.03,
   "end": 73.33,
   "tone": "ink"
  },
  {
