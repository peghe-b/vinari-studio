   "tone": "white"
  },
  {
   "text": "„ისევ?!“",
   "start": 20.54,
   "end": 21.04,
   "tone": "white"
  },
  {
   "text": "„ესეც კარგია, კარგიააა.",
   "start": 21.75,
   "end": 24.07,
   "tone": "white",
   "phone": true
  },
  {
   "text": "მოიყვანე კიდე ეგ",
   "start": 24.44,
   "end": 25.505,
   "tone": "ink",
   "phone": true
  },
  {
   "text": "#@% და ვნახოთ, რა სჭირს.“",
   "start": 25.505,
   "end": 27.54,
   "tone": "ink",
   "phone": true,
   "censor": true
  },
  {
   "text": "ჩეკი მხოლოდ იმას გეუბნება,",
   "start": 28.14,
   "end": 30.554,
   "tone": "white"
  },
  {
   "text": "რომ რაღაც ცუდადაა.",
   "start": 30.554,
   "end": 31.71,
   "tone": "white"
  },
  {
   "text": "რა, ამას არ გეუბნება.",
   "start": 32.35,
   "end": 34.26,
   "tone": "white"
  },
  {
   "text": "და გამოცნობაში ფულს შენ იხდი.",
   "start": 34.92,
   "end": 36.49,
   "tone": "white"
  },
  {
