 "subs": [
  {
   "text": "„რა ფუტი, შე",
   "start": 0.04,
   "end": 0.935,
   "tone": "white"
  },
  {
   "text": "„რა ფუტი, შე ბ#@%ო?!“",
   "start": 0.935,
   "end": 1.43,
   "tone": "white",
   "censor": true
  },
  {
   "text": "„მეტრებით ილაპარაკე!“",
   "start": 1.67,
   "end": 2.81,
   "tone": "white"
  },
  {
   "text": "In 500 feet, turn left onto",
   "start": 3.13,
   "end": 6.92,
   "tone": "white",
   "phone": true,
   "small": true
  },
  {
   "text": "Tchav... Tchavtchavadze Avenue.",
   "start": 7.32,
   "end": 10.41,
   "tone": "white",
   "phone": true,
   "small": true
  },
  {
   "text": "Recalculating.",
   "start": 11.72,
   "end": 12.91,
   "tone": "white",
   "phone": true,
   "small": true
  },
  {
   "text": "„აუ, ისევ გამოვტოვე.“",
   "start": 13.48,
   "end": 15.39,
   "tone": "white"
  },
  {
   "text": "„შემეშვი რა, დავიღალე უკვე.",
   "start": 15.84,
   "end": 17.97,
   "tone": "white"
  },
  {
   "text": "რას ბოდავს, იმენა?“",
   "start": 18.27,
   "end": 19.69,
   "tone": "white"
  },
  {
   "text": "Make a U-turn when possible.",
   "start": 20.217,
   "end": 22.507,
   "tone": "white",
   "phone": true,
   "small": true
  },
  {
   "text": "„სად დავტრიალდე, აქ?!“",
   "start": 22.727,
   "end": 24.017,
   "tone": "white"
  },
  {
   "text": "„ამდენი წვალება",
   "start": 24.497,
   "end": 25.418,
   "tone": "white"
  },
  {
   "text": "ერთი ვახშმისთვის...“",
   "start": 25.418,
   "end": 26.187,
   "tone": "white"
  },
  {
   "text": "ამ წვალებას ერთი რამე ჯობია:",
   "start": 28.457,
   "end": 30.327,
   "tone": "ink"
  },
  {
   "text": "ნავიგატორი, რომელიც",
   "start": 30.977,
   "end": 32.412,
   "tone": "ink"
  },
  {
   "text": "ქართულად გელაპარაკება.",
   "start": 32.412,
   "end": 33.807,
   "tone": "ink"
  },
  {
   "text": "ვინარში ნელსონი ან ალისა",
   "start": 34.437,
   "end": 36.277,
   "tone": "ink"
  },
  {
   "text": "გზას ქართულად გეტყვიან,",
   "start": 36.277,
   "end": 38.147,
   "tone": "ink"
  },
  {
   "text": "მეტრებით.",
   "start": 38.367,
   "end": 39.037,
   "tone": "ink"
  },
  {
   "text": "„600 მეტრში მარჯვნივ მოუხვიე.“",
   "start": 39.437,
   "end": 41.327,
   "tone": "ink",
   "phone": true
  },
  {
   "text": "წრეზე გასასვლელს დაგითვლის,",
   "start": 41.827,
   "end": 43.677,
   "tone": "ink"
  },
  {
   "text": "„წრეზე მეორე გასასვლელით გადი.“",
   "start": 44.027,
   "end": 45.857,
   "tone": "ink",
   "phone": true
  },
  {
   "text": "ზოლს მიგითითებს",
   "start": 46.979,
   "end": 48.057,
   "tone": "ink"
  },
  {
   "text": "და დატრიალებასაც გარკვევით გეტყვის.",
   "start": 48.057,
   "end": 50.369,
   "tone": "ink"
  },
  {
