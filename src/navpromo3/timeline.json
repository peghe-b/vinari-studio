   "end": 52.489,
   "tone": "ink",
   "phone": true
  },
  {
   "text": "და დატრიალდი.“",
   "start": 52.489,
   "end": 53.099,
   "tone": "ink",
   "phone": true
  },
  {
   "text": "კამერას, ბორცვს და რკინიგზის",
   "start": 53.599,
   "end": 55.377,
