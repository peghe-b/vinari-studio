 "subs": [
  {
   "text": "„სად ვარ?!“",
   "start": 0.06,
   "end": 1.23,
   "tone": "white"
  },
  {
   "text": "„სად ვარ აქანა?!“",
   "start": 1.23,
   "end": 2.85,
   "tone": "white"
  },
  {
   "text": "In 300 meters, turn right.",
   "start": 2.95,
   "end": 5.36,
   "tone": "white"
  },
  {
   "text": "„რაით?“",
   "start": 5.46,
   "end": 6.09,
   "tone": "white"
  },
  {
   "text": "Turn left.",
   "start": 6.1,
   "end": 6.96,
   "tone": "white"
  },
  {
   "text": "„ლეფთ?“",
   "start": 7.06,
   "end": 7.62,
   "tone": "white"
  },
  {
   "text": "„ლეფთი სადაა?“",
   "start": 7.62,
   "end": 8.48,
   "tone": "white"
  },
  {
   "text": "Recalculating...",
   "start": 8.49,
   "end": 9.61,
   "tone": "white"
  },
  {
   "text": "You have arrived.",
   "start": 9.7,
   "end": 10.84,
   "tone": "white"
  },
  {
   "text": "„დევიკარგე, შენ #@%&“",
   "start": 10.9,
   "end": 12.465,
   "tone": "white"
  },
  {
   "text": "„ვერ გევიგე, ენა არ მესმის“",
   "start": 12.565,
   "end": 14.605,
   "tone": "white"
  },
  {
   "text": "აი, ზუსტად ამიტომ",
   "start": 16.305,
   "end": 17.532,
   "tone": "white"
  },
  {
   "text": "შევქმენით Vinari.",
   "start": 17.532,
   "end": 18.995,
   "tone": "ink"
  },
  {
   "text": "ნავიგატორი, რომელიც",
   "start": 21.515,
   "end": 22.842,
   "tone": "ink"
  },
  {
   "text": "ქართულად გელაპარაკება.",
   "start": 22.842,
   "end": 23.915,
   "tone": "ink"
  },
  {
   "text": "„ინტერნეტი არ არის,",
   "start": 24.715,
   "end": 25.815,
   "tone": "ink"
  },
  {
   "text": "მაინც წაგიყვან.“",
   "start": 25.815,
   "end": 26.635,
   "tone": "ink"
  },
  {
   "text": "რუკა, ძებნა და ხმა",
   "start": 26.795,
   "end": 28.635,
   "tone": "ink"
  },
  {
   "text": "ტელეფონშივეა.",
   "start": 28.635,
   "end": 29.425,
   "tone": "ink"
  },
  {
   "text": "აბა, მოუსმინე.",
   "start": 29.645,
   "end": 30.425,
   "tone": "ink"
  },
  {
   "text": "„გამარჯობა, მე ნელსონი ვარ.“",
   "start": 30.625,
   "end": 32.785,
   "tone": "ink"
  },
  {
   "text": "„გამარჯობა, მე ალისა ვარ.“",
   "start": 32.845,
   "end": 34.805,
   "tone": "ink"
  },
  {
   "text": "„300 მეტრში მარჯვნივ მოუხვიე.“",
   "start": 34.965,
   "end": 36.895,
   "tone": "ink"
  },
  {
   "text": "„შოთა რუსთაველის გამზირზე.“",
   "start": 36.955,
   "end": 38.495,
   "tone": "ink"
  },
  {
   "text": "„წრეზე მეორე",
   "start": 38.615,
   "end": 39.415,
   "tone": "ink"
  },
  {
   "text": "გასასვლელით გადი.“",
   "start": 39.415,
   "end": 40.375,
   "tone": "ink"
  },
  {
   "text": "„მარჯვენა ზოლი დაიკავე.“",
   "start": 40.485,
   "end": 41.765,
   "tone": "ink"
  },
  {
   "text": "„წინ კამერაა.",
   "start": 41.875,
   "end": 42.935,
   "tone": "ink"
  },
  {
   "text": "ლიმიტში თუ ხარ,",
   "start": 42.935,
   "end": 43.845,
   "tone": "ink"
  },
  {
   "text": "ის უბრალოდ ყუთია.“",
   "start": 43.845,
   "end": 44.835,
   "tone": "ink"
  },
  {
   "text": "გრუნტის გზას აგარიდებს.",
   "start": 45.185,
   "end": 46.465,
   "tone": "ink"
  },
  {
   "text": "ხუმრობა არ გინდა?",
   "start": 46.645,
   "end": 47.845,
   "tone": "ink"
  },
  {
   "text": "გამორთე.",
   "start": 47.845,
   "end": 48.295,
   "tone": "ink"
  },
  {
   "text": "მოსაწყენო.",
   "start": 48.545,
   "end": 50.025,
   "tone": "ink"
  },
  {
   "text": "„ახლა მარჯვნივ მოუხვიე.“",
   "start": 50.565,
   "end": 51.865,
   "tone": "ink"
  },
  {
   "text": "მალე CarPlay-ზეც ნახავ,",
   "start": 52.045,
   "end": 53.735,
   "tone": "ink"
  },
  {
   "text": "სიტყვას გაძლევთ.",
   "start": 53.735,
   "end": 54.765,
   "tone": "ink"
  },
  {
   "text": "„მოვედით,",
   "start": 55.155,
   "end": 55.825,
   "tone": "ink"
  },
  {
   "text": "მარჯვენა მხარესაა.“",
   "start": 55.825,
   "end": 56.845,
   "tone": "ink"
  },
  {
   "text": "აწი აღარ დაიკარგები.",
   "start": 57.065,
   "end": 58.195,
   "tone": "ink"
  },
  {
   "text": "ეს მხოლოდ დასაწყისია.",
   "start": 58.445,
   "end": 60.015,
   "tone": "ink"
  },
  {
