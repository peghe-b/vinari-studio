 "subs": [
  {
   "text": "„მანქანა ხელს მიშლის,",
   "start": 0.1,
   "end": 1.23,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტო",
   "start": 1.23,
   "end": 1.5,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტოო",
   "start": 1.5,
   "end": 1.769,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტოოო",
   "start": 1.769,
   "end": 2.039,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტოოოო!“",
   "start": 2.039,
   "end": 2.308,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„შენი გაცნობა,",
   "start": 2.788,
   "end": 4.918,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„შენი გაცნობა, ლამაზო?“",
   "start": 4.918,
   "end": 6.038,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„აუუუ,",
   "start": 6.338,
   "end": 7.878,
   "tone": "white"
  },
  {
   "text": "„აუუუ, რა ტვინი მომი",
   "start": 7.878,
   "end": 8.809,
   "tone": "white"
  },
  {
   "text": "„აუუუ, რა ტვინი მომი#@%ეს…“",
   "start": 8.809,
   "end": 9.348,
   "tone": "white",
   "censor": true
  },
  {
   "text": "„ისევ უცნობი ნომერი...“",
   "start": 9.498,
   "end": 11.288,
   "tone": "white"
  },
  {
   "text": "„ნომერი საქარე მინაზე",
   "start": 14.568,
   "end": 16.076,
   "tone": "white"
  },
  {
   "text": "რამ დამაწერინა?“",
   "start": 16.076,
   "end": 16.818,
   "tone": "white"
  },
  {
   "text": "Vinari-ს QR ბარათი.",
   "start": 20.928,
   "end": 22.558,
   "tone": "ink"
  },
  {
   "text": "აპში შექმნი,",
   "start": 23.008,
   "end": 24.568,
   "tone": "ink"
  },
  {
   "text": "A4-ზე ამობეჭდავ",
   "start": 25.078,
   "end": 26.091,
   "tone": "ink"
  },
  {
   "text": "და საქარე მინის მიღმა დადებ.",
   "start": 26.091,
   "end": 27.878,
   "tone": "ink"
  },
  {
   "text": "ბარათზე არც შენი ნომერია,",
   "start": 28.658,
   "end": 30.408,
   "tone": "ink"
  },
  {
   "text": "არც მანქანის ნომერი.",
   "start": 30.848,
   "end": 31.958,
   "tone": "ink"
  },
  {
   "text": "მხოლოდ კოდი.",
   "start": 32.458,
   "end": 33.118,
   "tone": "ink"
  },
  {
   "text": "ვისაც რამე უნდა,",
   "start": 33.858,
   "end": 34.998,
   "tone": "ink"
  },
  {
   "text": "დაასკანერებს.",
   "start": 35.238,
   "end": 36.148,
   "tone": "ink"
  },
  {
   "text": "აპიც არ სჭირდება.",
   "start": 36.708,
   "end": 37.668,
   "tone": "white"
  },
  {
   "text": "სამ ღილაკს დაინახავს:",
   "start": 38.058,
   "end": 39.498,
   "tone": "ink"
  },
  {
   "text": "„მანქანა გზას მიკეტავს“,",
   "start": 40.168,
   "end": 41.628,
   "tone": "ink"
  },
  {
   "text": "„შუქები ანთია“,",
   "start": 41.988,
   "end": 42.938,
   "tone": "white"
  },
  {
   "text": "„მანქანასთან რაღაც ხდება“.",
   "start": 43.368,
   "end": 44.608,
   "tone": "ink"
  },
  {
   "text": "მიზეზს აირჩევს",
   "start": 45.228,
   "end": 46.319,
   "tone": "ink"
  },
  {
   "text": "და ერთი დაჭერით გაგზავნის.",
   "start": 46.319,
   "end": 47.688,
   "tone": "ink"
  },
  {
   "text": "შენ შეტყობინება მოგივა.",
   "start": 47.938,
   "end": 49.388,
   "tone": "white"
  },
  {
   "text": "ზარი არა.",
   "start": 49.888,
   "end": 50.738,
   "tone": "white"
  },
  {
   "text": "შენს ნომერს ვერავინ გაიგებს.",
   "start": 51.248,
   "end": 52.728,
   "tone": "white"
  },
  {
   "text": "სპამი არ იქნება:",
   "start": 53.208,
   "end": 54.228,
   "tone": "white"
  },
  {
   "text": "ერთი ბარათიდან ხშირად ვერავინ მოგწერს.",
   "start": 54.528,
   "end": 56.708,
   "tone": "white"
  },
  {
   "text": "ღამით, თუ გინდა, უხმოდ მოვა.",
   "start": 56.878,
   "end": 58.958,
   "tone": "white"
  },
  {
   "text": "ბარათს კი ნებისმიერ დროს გათიშავ.",
   "start": 59.408,
   "end": 61.108,
   "tone": "white"
  },
  {
   "text": "„აი, ახლა კი მშვიდად.“",
   "start": 62.008,
   "end": 63.548,
   "tone": "white"
  },
  {
   "text": "Vinari ჩაიწერე,",
   "start": 64.499,
   "end": 65.799,
   "tone": "ink"
  },
  {
   "text": "App Store-სა და Google Play-ზეა.",
   "start": 66.289,
   "end": 68.068,
   "tone": "ink"
  }
 ],
