 "subs": [
  {
   "text": "„მანქანა ხელს მიშლის,",
   "start": 0.1,
   "end": 1.23,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტო",
   "start": 1.23,
   "end": 1.5,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტოო",
   "start": 1.5,
   "end": 1.769,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტოოო",
   "start": 1.769,
   "end": 2.039,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტოოოო!“",
   "start": 2.039,
   "end": 2.308,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„შენი გაცნობა,",
   "start": 2.788,
   "end": 4.918,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„შენი გაცნობა, ლამაზო?“",
   "start": 4.918,
   "end": 6.038,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„აუუუ,",
   "start": 6.338,
   "end": 7.878,
   "tone": "white"
  },
  {
   "text": "„აუუუ, რა ტვინი მომი",
   "start": 7.878,
   "end": 8.809,
   "tone": "white"
  },
  {
   "text": "„აუუუ, რა ტვინი მომი#@%ეს…“",
   "start": 8.809,
   "end": 9.348,
   "tone": "white",
   "censor": true
  },
  {
   "text": "„ისევ უცნობი ნომერი...“",
   "start": 9.498,
   "end": 11.288,
   "tone": "white"
  },
  {
   "text": "„ნომერი საქარე მინაზე",
   "start": 14.568,
   "end": 16.076,
   "tone": "white"
  },
  {
   "text": "რამ დამაწერინა?“",
   "start": 16.076,
   "end": 16.818,
   "tone": "white"
  },
  {
   "text": "Vinari-ს QR ბარათი.",
   "start": 21.198,
   "end": 22.828,
   "tone": "ink"
  },
  {
   "text": "აპში შექმნი,",
   "start": 23.278,
   "end": 24.838,
   "tone": "ink"
  },
  {
   "text": "A4-ზე ამობეჭდავ",
   "start": 25.348,
   "end": 26.361,
   "tone": "ink"
  },
  {
   "text": "და საქარე მინის მიღმა დადებ.",
   "start": 26.361,
   "end": 28.148,
   "tone": "ink"
  },
  {
   "text": "ბარათზე არც შენი ნომერია,",
   "start": 28.928,
   "end": 30.678,
   "tone": "ink"
  },
  {
   "text": "არც მანქანის ნომერი.",
   "start": 31.118,
   "end": 32.228,
   "tone": "ink"
  },
  {
   "text": "მხოლოდ კოდი.",
   "start": 32.728,
   "end": 33.388,
   "tone": "ink"
  },
  {
   "text": "ვისაც რამე უნდა,",
   "start": 34.128,
   "end": 35.268,
   "tone": "ink"
  },
  {
   "text": "დაასკანერებს.",
   "start": 35.508,
   "end": 36.418,
   "tone": "ink"
  },
  {
   "text": "აპიც არ სჭირდება.",
   "start": 36.978,
   "end": 37.938,
   "tone": "white"
  },
  {
   "text": "სამ ღილაკს დაინახავს:",
   "start": 38.328,
   "end": 39.768,
   "tone": "ink"
  },
  {
   "text": "„მანქანა გზას მიკეტავს“,",
   "start": 40.438,
   "end": 41.898,
   "tone": "ink"
  },
  {
   "text": "„შუქები ანთია“,",
   "start": 42.258,
   "end": 43.208,
   "tone": "white"
  },
  {
   "text": "„მანქანასთან რაღაც ხდება“.",
   "start": 43.638,
   "end": 44.878,
   "tone": "ink"
  },
  {
   "text": "მიზეზს აირჩევს",
   "start": 45.498,
   "end": 46.589,
   "tone": "ink"
  },
  {
   "text": "და ერთი დაჭერით გაგზავნის.",
   "start": 46.589,
   "end": 47.958,
   "tone": "ink"
  },
  {
   "text": "შენ შეტყობინება მოგივა.",
   "start": 48.208,
   "end": 49.658,
   "tone": "white"
  },
  {
   "text": "ზარი არა.",
   "start": 50.158,
   "end": 51.008,
   "tone": "white"
  },
  {
   "text": "შენს ნომერს ვერავინ გაიგებს.",
   "start": 51.518,
   "end": 52.998,
   "tone": "white"
  },
  {
   "text": "სპამი არ იქნება:",
   "start": 53.478,
   "end": 54.498,
   "tone": "white"
  },
  {
   "text": "ერთი ბარათიდან ხშირად ვერავინ მოგწერს.",
   "start": 54.798,
   "end": 56.978,
   "tone": "white"
  },
  {
   "text": "ღამით, თუ გინდა, უხმოდ მოვა.",
   "start": 57.148,
   "end": 59.228,
   "tone": "white"
  },
  {
   "text": "ბარათს კი ნებისმიერ დროს გათიშავ.",
   "start": 59.678,
   "end": 61.378,
   "tone": "white"
  },
  {
   "text": "„აი, ახლა კი მშვიდად.“",
   "start": 62.278,
   "end": 63.818,
   "tone": "white"
  },
  {
   "text": "Vinari ჩაიწერე,",
   "start": 64.768,
   "end": 66.068,
   "tone": "ink"
  },
  {
   "text": "App Store-სა და Google Play-ზეა.",
   "start": 66.559,
   "end": 68.339,
   "tone": "ink"
  }
 ],
