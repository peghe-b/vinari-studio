 "subs": [
  {
   "text": "„მანქანა ხელს მიშლის,",
   "start": 0.1,
   "end": 1.23,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტო",
   "start": 1.23,
   "end": 1.5,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტოო",
   "start": 1.5,
   "end": 1.769,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტოოო",
   "start": 1.769,
   "end": 2.039,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტოოოო!“",
   "start": 2.039,
   "end": 2.308,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„შენი გაცნობა,",
   "start": 2.788,
   "end": 4.918,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„შენი გაცნობა, ლამაზო?“",
   "start": 4.918,
   "end": 6.038,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„აუუუ,",
   "start": 6.338,
   "end": 7.878,
   "tone": "white"
  },
  {
   "text": "„აუუუ, რა ტვინი მომი",
   "start": 7.878,
   "end": 8.809,
   "tone": "white"
  },
  {
   "text": "„აუუუ, რა ტვინი მომი#@%ეს…“",
   "start": 8.809,
   "end": 9.348,
   "tone": "white",
   "censor": true
  },
  {
   "text": "„ისევ უცნობი ნომერი...“",
   "start": 9.498,
   "end": 11.288,
   "tone": "white"
  },
  {
   "text": "„ნომერი საქარე მინაზე",
   "start": 14.568,
   "end": 16.076,
   "tone": "white"
  },
  {
   "text": "რამ დამაწერინა?“",
   "start": 16.076,
   "end": 16.818,
   "tone": "white"
  },
  {
   "text": "Vinari-ს QR ბარათი.",
   "start": 20.468,
   "end": 21.708,
   "tone": "ink"
  },
  {
   "text": "ნომერი აღარ გჭირდება,",
   "start": 22.288,
   "end": 23.418,
   "tone": "ink"
  },
  {
   "text": "ბარათზე მხოლოდ კოდია.",
   "start": 23.768,
   "end": 24.918,
   "tone": "ink"
  },
  {
   "text": "ვისაც რამე უნდა,",
   "start": 25.548,
   "end": 26.557,
   "tone": "ink"
  },
  {
   "text": "დაასკანერებს.",
   "start": 26.557,
   "end": 27.048,
   "tone": "ink"
  },
  {
   "text": "აპიც არ სჭირდება.",
   "start": 27.418,
   "end": 28.208,
   "tone": "white"
  },
  {
   "text": "სამ ღილაკს დაინახავს:",
   "start": 28.828,
   "end": 29.928,
   "tone": "ink"
  },
  {
   "text": "„მანქანა გზას მიკეტავს“,",
   "start": 30.558,
   "end": 31.808,
   "tone": "ink"
  },
  {
   "text": "„შუქები ანთია“,",
   "start": 32.228,
   "end": 33.168,
   "tone": "white"
  },
  {
   "text": "„მანქანასთან რაღაც ხდება“.",
   "start": 33.678,
   "end": 34.898,
   "tone": "ink"
  },
  {
   "text": "მიზეზს აირჩევს",
   "start": 35.698,
   "end": 36.474,
   "tone": "ink"
  },
  {
   "text": "და ერთი დაჭერით გაგზავნის.",
   "start": 36.474,
   "end": 37.728,
   "tone": "ink"
  },
  {
   "text": "შენ შეტყობინება მოგივა,",
   "start": 38.388,
   "end": 39.588,
   "tone": "white"
  },
  {
   "text": "შენი ნომრის გარეშე.",
   "start": 39.938,
   "end": 40.918,
   "tone": "white"
  },
  {
   "text": "„აი, ახლა კი მშვიდად.“",
   "start": 41.938,
   "end": 43.478,
   "tone": "white"
  },
  {
   "text": "Vinari ჩაიწერე,",
   "start": 44.428,
   "end": 45.288,
   "tone": "ink"
  },
  {
   "text": "App Store-სა და Google Play-ზეა.",
   "start": 45.668,
   "end": 47.008,
   "tone": "ink"
  }
 ],
