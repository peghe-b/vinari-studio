 "subs": [
  {
   "text": "„მანქანა ხელს მიშლის,",
   "start": 0.1,
   "end": 1.23,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტო",
   "start": 1.23,
   "end": 1.5,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტოო",
   "start": 1.5,
   "end": 1.769,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტოოო",
   "start": 1.769,
   "end": 2.039,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„მანქანა ხელს მიშლის, ტოოოო!“",
   "start": 2.039,
   "end": 2.308,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„შენი გაცნობა,",
   "start": 2.788,
   "end": 4.918,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„შენი გაცნობა, ლამაზო?“",
   "start": 4.918,
   "end": 6.038,
   "tone": "white",
   "phone": true
  },
  {
   "text": "„აუუუ,",
   "start": 6.338,
   "end": 7.878,
   "tone": "white"
  },
  {
   "text": "„აუუუ, რა ტვინი მომი",
   "start": 7.878,
   "end": 8.809,
   "tone": "white"
  },
  {
   "text": "„აუუუ, რა ტვინი მომი#@%ეს…“",
   "start": 8.809,
   "end": 9.348,
   "tone": "white",
   "censor": true
  },
  {
   "text": "„ისევ უცნობი ნომერი...“",
   "start": 9.498,
   "end": 11.288,
   "tone": "white"
  },
  {
   "text": "„ნომერი საქარე მინაზე",
   "start": 14.568,
   "end": 16.076,
   "tone": "white"
  },
  {
   "text": "რამ დამაწერინა?“",
   "start": 16.076,
   "end": 16.818,
   "tone": "white"
  },
  {
   "text": "Vinari-ს QR ბარათი.",
   "start": 22.348,
   "end": 23.978,
   "tone": "ink"
  },
  {
   "text": "აპში შექმნი,",
   "start": 24.429,
   "end": 25.989,
   "tone": "ink"
  },
  {
   "text": "A4-ზე ამობეჭდავ",
   "start": 26.499,
   "end": 27.511,
   "tone": "ink"
  },
  {
   "text": "და საქარე მინის მიღმა დადებ.",
   "start": 27.511,
   "end": 29.298,
   "tone": "ink"
  },
  {
   "text": "ბარათზე არც შენი ნომერია,",
   "start": 30.078,
   "end": 31.828,
   "tone": "ink"
  },
  {
   "text": "არც მანქანის ნომერი.",
   "start": 32.268,
   "end": 33.378,
   "tone": "ink"
  },
  {
   "text": "მხოლოდ კოდი.",
   "start": 33.878,
   "end": 34.538,
   "tone": "ink"
  },
  {
   "text": "ვისაც რამე უნდა,",
   "start": 35.278,
   "end": 36.418,
   "tone": "ink"
  },
  {
   "text": "დაასკანერებს.",
   "start": 36.658,
   "end": 37.568,
   "tone": "ink"
  },
  {
   "text": "აპიც არ სჭირდება.",
   "start": 38.128,
   "end": 39.088,
   "tone": "white"
  },
  {
   "text": "სამ ღილაკს დაინახავს:",
   "start": 39.478,
   "end": 40.918,
   "tone": "ink"
  },
  {
   "text": "„მანქანა გზას მიკეტავს“,",
   "start": 41.588,
   "end": 43.048,
   "tone": "ink"
  },
  {
   "text": "„შუქები ანთია“,",
   "start": 43.408,
   "end": 44.358,
   "tone": "white"
  },
  {
   "text": "„მანქანასთან რაღაც ხდება“.",
   "start": 44.788,
   "end": 46.028,
   "tone": "ink"
  },
  {
   "text": "მიზეზს აირჩევს",
   "start": 46.648,
   "end": 47.739,
   "tone": "ink"
  },
  {
   "text": "და ერთი დაჭერით გაგზავნის.",
   "start": 47.739,
   "end": 49.108,
   "tone": "ink"
  },
  {
   "text": "შენ შეტყობინება მოგივა.",
   "start": 49.358,
   "end": 50.808,
   "tone": "white"
  },
  {
   "text": "ზარი არა.",
   "start": 51.308,
   "end": 52.158,
   "tone": "white"
  },
  {
   "text": "შენს ნომერს ვერავინ გაიგებს.",
   "start": 52.668,
   "end": 54.149,
   "tone": "white"
  },
  {
   "text": "სპამი არ იქნება:",
   "start": 54.628,
   "end": 55.649,
   "tone": "white"
  },
  {
   "text": "ერთი ბარათიდან ხშირად ვერავინ მოგწერს.",
   "start": 55.948,
   "end": 58.128,
   "tone": "white"
  },
  {
   "text": "ღამით, თუ გინდა, უხმოდ მოვა.",
   "start": 58.298,
   "end": 60.378,
   "tone": "white"
  },
  {
   "text": "ბარათს კი ნებისმიერ დროს გათიშავ.",
   "start": 60.828,
   "end": 62.528,
   "tone": "white"
  },
  {
   "text": "„აი, ახლა კი მშვიდად.“",
   "start": 63.428,
   "end": 64.968,
   "tone": "white"
  },
  {
   "text": "Vinari ჩაიწერე,",
   "start": 65.918,
   "end": 67.218,
   "tone": "ink"
  },
  {
   "text": "App Store-სა და Google Play-ზეა.",
   "start": 67.709,
   "end": 69.489,
   "tone": "ink"
  }
 ],
 "music": {}
